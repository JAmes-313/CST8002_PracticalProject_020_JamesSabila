    ///Author: James Sabila
    ///Subject: Prgramming Language Research - Practical Project 2
    ///Link: [1] Microsoft Learn (n.d.) ASP.NET MVC Controllers Overview (C#). learn.microsoft.com. [online] Available at: https://learn.microsoft.com/en-us/aspnet/mvc/overview/older-versions-1/controllers-and-routing/aspnet-mvc-controllers-overview-cs [Accessed on June 21, 2026].
    ///
</summary>*@

@{
    ViewData["Title"] = "Home Page";
}
@model List<CsvFullModel>

<link rel="stylesheet" href="~/css/homecsv.css" />

<div class="text-center">
    <h1>CSV Data - James Sabila</h1>

    <div class="text-start filter">
        <form asp-action="FilterBy" method="get">
            <label>Filter By</label>

            <select name="filterOption" onchange="this.form.submit()">
                <option value="" disabled selected hidden>Select An Option</option>
                <option value="Year">Year</option>
                <option value="Species">Species</option>
                <option value="Common Name">Common Name</option>
                <option value="Study Site">Study Site</option>
                <option value="Associated Community">Associated Community</option>
                <option value="Retinol">Retinol</option>
            </select>
        </form>
    </div>
    

    <table>
        <thead>
            <tr>
                <th>Year</th>
                <th>Species</th>
                <th>Common Name</th>
                <th>Study Site</th>
                <th>Associated Community</th>
                <th>Retinol</th>
                <th class="text-center" colspan="2">Operation</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Year</td>
                    <td>@item.Species</td>
                    <td>@item.CommonName</td>
                    <td>@item.StudySite</td>
                    <td>@item.AssociatedCommunity</td>
                    <td>@item.Retinol</td>
                    <td>
                        <a asp-action="EditRecord" asp-route-id="@item.Id">Edit</a>
                    </td>
                    <td>
                        <form asp-action="Delete" method="post">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
