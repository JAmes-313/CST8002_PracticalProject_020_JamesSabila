@{
    ViewData["Title"] = "Home Page";
}
@model List<CsvFullModel>

<link rel="stylesheet" href="~/css/homecsv.css" />

<div class="text-center">
    <h1>CSV Data</h1>

    <table>
        <thead>
            <tr>
                <th>Year</th>
                <th>Species</th>
                <th>Common Name</th>
                <th>Study Site</th>
                <th>Associated Community</th>
                <th>Retinol</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Year</td>
                    <td>@item.Species</td>
                    <td>@item.CommonName</td>
                    <td>@item.StudySite</td>
                    <td>@item.AssociatedCommunity</td>
                    <td>@item.Retinol</td>
                    <td>
                        <form asp-action="Delete" method="post">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
